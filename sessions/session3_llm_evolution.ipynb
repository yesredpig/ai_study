            "['AI', 'helps', 'doctors', 'diagnose', 'disease', '<EOS>']\n",
            "\n",
            "Input shape:\n",
            "torch.Size([8, 6])\n",
            "\n",
            "Target shape:\n",
            "torch.Size([8, 6])\n"
          ]

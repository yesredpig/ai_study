    {
      "cell_type": "code",
      "source": [
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Mini GPT 모델\n",
        "#\n",
        "# 구성:\n",
        "# 1) Token Embedding\n",
        "# 2) Position Embedding\n",
        "# 3) Causal Transformer\n",
        "# 4) Vocabulary Logits 출력\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "class MiniGPT(nn.Module):\n",
        "\n",
        "    def __init__(\n",
        "        self,\n",
        "        vocab_size,\n",
        "        max_sequence_length,\n",
        "        embedding_dim=64,\n",
        "        num_heads=4,\n",
        "        num_layers=2,\n",
        "        dropout=0.1,\n",
        "    ):\n",
        "        super().__init__()\n",
        "\n",
        "        self.max_sequence_length = max_sequence_length\n",
        "\n",
        "        # 각 token ID를 embedding vector로 변환합니다.\n",
        "        self.token_embedding = nn.Embedding(\n",
        "            vocab_size,\n",
        "            embedding_dim\n",
        "        )\n",
        "\n",
        "        # 각 토큰의 위치 정보를 학습합니다.\n",
        "        self.position_embedding = nn.Embedding(\n",
        "            max_sequence_length,\n",
        "            embedding_dim\n",
        "        )\n",
        "\n",
        "        transformer_layer = nn.TransformerEncoderLayer(\n",
        "            d_model=embedding_dim,\n",
        "            nhead=num_heads,\n",
        "            dim_feedforward=embedding_dim * 4,\n",
        "            dropout=dropout,\n",
        "            activation=\"gelu\",\n",
        "            batch_first=True,\n",
        "        )\n",
        "\n",
        "        self.transformer = nn.TransformerEncoder(\n",
        "            transformer_layer,\n",
        "            num_layers=num_layers\n",
        "        )\n",
        "\n",
        "        self.layer_norm = nn.LayerNorm(\n",
        "            embedding_dim\n",
        "        )\n",
        "\n",
        "        # 각 위치의 hidden state를\n",
        "        # vocabulary 전체의 logits으로 변환합니다.\n",
        "        self.lm_head = nn.Linear(\n",
        "            embedding_dim,\n",
        "            vocab_size,\n",
        "            bias=False\n",
        "        )\n",
        "\n",
        "    def forward(self, input_ids, targets=None):\n",
        "\n",
        "        batch_size, sequence_length = input_ids.shape\n",
        "\n",
        "        if sequence_length > self.max_sequence_length:\n",
        "            raise ValueError(\n",
        "                \"입력 길이가 모델의 최대 sequence 길이를 초과했습니다.\"\n",
        "            )\n",
        "\n",
        "        # 각 위치를 나타내는 position ID\n",
        "        positions = torch.arange(\n",
        "            sequence_length,\n",
        "            device=input_ids.device\n",
        "        )\n",
        "\n",
        "        # Token embedding과 position embedding을 더합니다.\n",
        "        token_embeddings = self.token_embedding(\n",
        "            input_ids\n",
        "        )\n",
        "\n",
        "        position_embeddings = self.position_embedding(\n",
        "            positions\n",
        "        )\n",
        "\n",
        "        hidden_states = (\n",
        "            token_embeddings\n",
        "            + position_embeddings.unsqueeze(0)\n",
        "        )\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Causal Mask\n",
        "        #\n",
        "        # 미래 위치를 -inf로 만들어 attention할 수 없게 합니다.\n",
        "        #\n",
        "        # 예:\n",
        "        #\n",
        "        # 위치 1은 위치 1만 볼 수 있음\n",
        "        # 위치 2는 위치 1, 2를 볼 수 있음\n",
        "        # 위치 3은 위치 1, 2, 3을 볼 수 있음\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        causal_mask = torch.triu(\n",
        "            torch.full(\n",
        "                (\n",
        "                    sequence_length,\n",
        "                    sequence_length\n",
        "                ),\n",
        "                float(\"-inf\"),\n",
        "                device=input_ids.device\n",
        "            ),\n",
        "            diagonal=1\n",
        "        )\n",
        "\n",
        "        hidden_states = self.transformer(\n",
        "            hidden_states,\n",
        "            mask=causal_mask\n",
        "        )\n",
        "\n",
        "        hidden_states = self.layer_norm(\n",
        "            hidden_states\n",
        "        )\n",
        "\n",
        "        # 출력 shape:\n",
        "        # [batch_size, sequence_length, vocab_size]\n",
        "        logits = self.lm_head(\n",
        "            hidden_states\n",
        "        )\n",
        "\n",
        "        loss = None\n",
        "\n",
        "        if targets is not None:\n",
        "\n",
        "            # Cross-Entropy Loss 계산을 위해\n",
        "            # batch와 sequence 차원을 하나로 합칩니다.\n",
        "            #\n",
        "            # 기존:\n",
        "            # [batch_size, sequence_length, vocab_size]\n",
        "            #\n",
        "            # 변환:\n",
        "            # [batch_size × sequence_length, vocab_size]\n",
        "\n",
        "            flat_logits = logits.reshape(\n",
        "                -1,\n",
        "                vocab_size\n",
        "            )\n",
        "\n",
        "            flat_targets = targets.reshape(-1)\n",
        "\n",
        "            # 모든 문장과 모든 위치의\n",
        "            # next-token loss를 평균합니다.\n",
        "            loss = F.cross_entropy(\n",
        "                flat_logits,\n",
        "                flat_targets\n",
        "            )\n",
        "\n",
        "        return logits, loss\n",
        "\n",
        "\n",
        "model = MiniGPT(\n",
        "    vocab_size=vocab_size,\n",
        "    max_sequence_length=sequence_length,\n",
        ").to(device)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. 학습 전 Forward Pass\n",
        "#\n",
        "# 한 번의 forward pass에서 모든 위치의\n",
        "# 다음 토큰 logits을 병렬로 계산합니다.\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "logits, initial_loss = model(\n",
        "    inputs,\n",
        "    targets\n",
        ")\n",
        "\n",
        "print(\"\\nLogits shape:\")\n",
        "print(logits.shape)\n",
        "\n",
        "print(\"\\nInitial loss:\")\n",
        "print(initial_loss.item())\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. 학습\n",
        "#\n",
        "# 1) Forward Pass\n",
        "# 2) Cross-Entropy Loss 계산\n",
        "# 3) Backpropagation\n",
        "# 4) Optimizer Step\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "optimizer = torch.optim.AdamW(\n",
        "    model.parameters(),\n",
        "    lr=0.003\n",
        ")\n",
        "\n",
        "num_epochs = 1000\n",
        "\n",
        "model.train()\n",
        "\n",
        "for epoch in range(1, num_epochs + 1):\n",
        "\n",
        "    # 모든 위치의 next-token logits과 loss 계산\n",
        "    logits, loss = model(\n",
        "        inputs,\n",
        "        targets\n",
        "    )\n",
        "\n",
        "    # 이전 gradient 초기화\n",
        "    optimizer.zero_grad()\n",
        "\n",
        "    # Loss를 기준으로 gradient 계산\n",
        "    loss.backward()\n",
        "\n",
        "    # Gradient가 지나치게 커지는 것을 방지\n",
        "    torch.nn.utils.clip_grad_norm_(\n",
        "        model.parameters(),\n",
        "        max_norm=1.0\n",
        "    )\n",
        "\n",
        "    # Loss가 감소하는 방향으로 파라미터 업데이트\n",
        "    optimizer.step()\n",
        "\n",
        "    if epoch == 1 or epoch % 100 == 0:\n",
        "        print(\n",
        "            f\"Epoch {epoch:4d} | \"\n",
        "            f\"Loss {loss.item():.4f}\"\n",
        "        )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. 각 위치의 예측 결과 확인\n",
        "#\n",
        "# 예시 문장:\n",
        "# AI helps doctors diagnose disease\n",
        "#\n",
        "# 모델은 다음 문제들을 한 번에 계산합니다.\n",
        "#\n",
        "# <BOS>                       → AI\n",
        "# <BOS> AI                    → helps\n",
        "# <BOS> AI helps              → doctors\n",
        "# <BOS> AI helps doctors      → diagnose\n",
        "# <BOS> AI helps doctors diagnose → disease\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "model.eval()\n",
        "\n",
        "with torch.no_grad():\n",
        "\n",
        "    example_input_batch = example_input.unsqueeze(0).to(\n",
        "        device\n",
        "    )\n",
        "\n",
        "    example_logits, _ = model(\n",
        "        example_input_batch\n",
        "    )\n",
        "\n",
        "    predicted_ids = torch.argmax(\n",
        "        example_logits,\n",
        "        dim=-1\n",
        "    )[0]\n",
        "\n",
        "print(\"\\nPosition-wise predictions:\")\n",
        "\n",
        "visible_context = []\n",
        "\n",
        "for position, token_id in enumerate(\n",
        "    example_input.tolist()\n",
        "):\n",
        "\n",
        "    current_token = id_to_token[token_id]\n",
        "    visible_context.append(current_token)\n",
        "\n",
        "    predicted_token = id_to_token[\n",
        "        predicted_ids[position].item()\n",
        "    ]\n",
        "\n",
        "    correct_token = id_to_token[\n",
        "        example_target[position].item()\n",
        "    ]\n",
        "\n",
        "    print(\n",
        "        f\"{' '.join(visible_context):45s}\"\n",
        "        f\" → predicted: {predicted_token:10s}\"\n",
        "        f\" | target: {correct_token}\"\n",
        "    )\n",
        "\n",
        "\n",
        "\n"
      ],

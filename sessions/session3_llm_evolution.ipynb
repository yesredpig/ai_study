    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# Mini GPT 학습 예제\n",
        "# - 단어 단위 tokenizer\n",
        "# - Input / Target 한 칸 이동\n",
        "# - Causal Mask\n",
        "# - Cross-Entropy Loss\n",
        "# - Backpropagation\n",
        "# - Autoregressive Generation\n",
        "# ============================================================\n",
        "\n",
        "import random\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. 실행 환경과 난수 고정\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "torch.manual_seed(42)\n",
        "random.seed(42)\n",
        "\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "\n",
        "print(\"Device:\", device)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. 학습 데이터\n",
        "#\n",
        "# 같은 문장 하나만 반복하면 모델이 문장을 암기하기 쉬우므로,\n",
        "# 비슷한 구조의 여러 문장을 사용합니다.\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "sentences = [\n",
        "    \"AI helps doctors diagnose disease\",\n",
        "    \"AI helps doctors analyze symptoms\",\n",
        "    \"AI helps doctors review records\",\n",
        "    \"AI helps nurses monitor patients\",\n",
        "    \"Doctors diagnose disease using data\",\n",
        "    \"Doctors analyze symptoms using data\",\n",
        "    \"Nurses monitor patients every day\",\n",
        "    \"Medical AI supports clinical decisions\",\n",
        "]\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. 단어 단위 Vocabulary 구성\n",
        "#\n",
        "# 실제 GPT는 BPE와 같은 subword tokenizer를 사용하지만,\n",
        "# 여기서는 next-token prediction 구조를 쉽게 확인하기 위해\n",
        "# 단어 단위 tokenizer를 사용합니다.\n",
        "#\n",
        "# <BOS>: 문장 시작\n",
        "# <EOS>: 문장 종료\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "special_tokens = [\"<BOS>\", \"<EOS>\"]\n",
        "\n",
        "words = sorted(\n",
        "    set(\n",
        "        word\n",
        "        for sentence in sentences\n",
        "        for word in sentence.split()\n",
        "    )\n",
        ")\n",
        "\n",
        "vocabulary = special_tokens + words\n",
        "\n",
        "token_to_id = {\n",
        "    token: index\n",
        "    for index, token in enumerate(vocabulary)\n",
        "}\n",
        "\n",
        "id_to_token = {\n",
        "    index: token\n",
        "    for token, index in token_to_id.items()\n",
        "}\n",
        "\n",
        "vocab_size = len(vocabulary)\n",
        "\n",
        "print(\"\\nVocabulary:\")\n",
        "print(token_to_id)\n",
        "\n",
        "print(\"\\nVocabulary size:\", vocab_size)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. 문장을 Token ID로 변환하는 함수\n",
        "#\n",
        "# 예:\n",
        "# \"AI helps doctors diagnose disease\"\n",
        "#\n",
        "# →\n",
        "#\n",
        "# <BOS> AI helps doctors diagnose disease <EOS>\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def encode(sentence):\n",
        "    tokens = [\"<BOS>\"] + sentence.split() + [\"<EOS>\"]\n",
        "\n",
        "    return [\n",
        "        token_to_id[token]\n",
        "        for token in tokens\n",
        "    ]\n",
        "\n",
        "\n",
        "def decode(token_ids):\n",
        "    tokens = [\n",
        "        id_to_token[token_id]\n",
        "        for token_id in token_ids\n",
        "    ]\n",
        "\n",
        "    # 특수 토큰은 출력에서 제외합니다.\n",
        "    tokens = [\n",
        "        token\n",
        "        for token in tokens\n",
        "        if token not in {\"<BOS>\", \"<EOS>\"}\n",
        "    ]\n",
        "\n",
        "    return \" \".join(tokens)\n",
        "\n",
        "\n",
        "encoded_sentences = [\n",
        "    torch.tensor(\n",
        "        encode(sentence),\n",
        "        dtype=torch.long\n",
        "    )\n",
        "    for sentence in sentences\n",
        "]\n",
        "\n",
        "print(\"\\nEncoded example:\")\n",
        "print(encoded_sentences[0])\n",
        "\n",
        "print(\"\\nDecoded example:\")\n",
        "print(decode(encoded_sentences[0].tolist()))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Input과 Target을 한 칸 이동\n",
        "#\n",
        "# 원본:\n",
        "# <BOS> AI helps doctors diagnose disease <EOS>\n",
        "#\n",
        "# Input:\n",
        "# <BOS> AI helps doctors diagnose disease\n",
        "#\n",
        "# Target:\n",
        "# AI helps doctors diagnose disease <EOS>\n",
        "#\n",
        "# 각 위치에서 다음 토큰을 예측합니다.\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "example = encoded_sentences[0]\n",
        "\n",
        "example_input = example[:-1]\n",
        "example_target = example[1:]\n",
        "\n",
        "print(\"\\nInput tokens:\")\n",
        "print([\n",
        "    id_to_token[token_id.item()]\n",
        "    for token_id in example_input\n",
        "])\n",
        "\n",
        "print(\"\\nTarget tokens:\")\n",
        "print([\n",
        "    id_to_token[token_id.item()]\n",
        "    for token_id in example_target\n",
        "])\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Batch 생성\n",
        "#\n",
        "# 모든 문장의 길이를 동일하게 맞추기 위해\n",
        "# 여기서는 길이가 같은 문장들만 사용합니다.\n",
        "#\n",
        "# 실제 LLM 학습에서는 padding과 attention mask를 사용하거나,\n",
        "# 여러 문장을 긴 token stream으로 연결해 학습합니다.\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "sequence_lengths = [\n",
        "    len(sentence)\n",
        "    for sentence in encoded_sentences\n",
        "]\n",
        "\n",
        "if len(set(sequence_lengths)) != 1:\n",
        "    raise ValueError(\n",
        "        \"이 예제에서는 모든 학습 문장의 토큰 길이가 같아야 합니다.\"\n",
        "    )\n",
        "\n",
        "training_data = torch.stack(\n",
        "    encoded_sentences\n",
        ").to(device)\n",
        "\n",
        "# 입력과 정답을 한 칸 이동합니다.\n",
        "inputs = training_data[:, :-1]\n",
        "targets = training_data[:, 1:]\n",
        "\n",
        "batch_size, sequence_length = inputs.shape\n",
        "\n",
        "print(\"\\nInput shape:\")\n",
        "print(inputs.shape)\n",
        "\n",
        "\n",
        "print(\"\\nTarget shape:\")\n",
        "print(targets.shape)\n",
        "\n",
        "\n"
      ],

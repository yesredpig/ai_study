    {
      "cell_type": "markdown",
      "source": [
        "**TopK, TopP sampling**\n",
        "![Top-k / Top-p Sampling](sessions/images/topk_topp_sampling.png),
      "metadata": {
        "id": "Kxsk1CVN7Zmk"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# 14. Temperature에 따른 다음 토큰 확률 비교\n",
        "#\n",
        "# Prompt:\n",
        "# \"AI helps\"\n",
        "#\n",
        "# 각 temperature에서 다음 토큰의 확률이\n",
        "# 어떻게 달라지는지 Top-5 후보를 출력합니다.\n",
        "# ============================================================\n",
        "\n",
        "@torch.no_grad()\n",
        "def show_next_token_probabilities(\n",
        "    model,\n",
        "    prompt,\n",
        "    temperatures=(0.3, 1.0, 1.5),\n",
        "    top_n=5,\n",
        "):\n",
        "\n",
        "    model.eval()\n",
        "\n",
        "    prompt_tokens = [\n",
        "        \"<BOS>\"\n",
        "    ] + prompt.split()\n",
        "\n",
        "    token_ids = [\n",
        "        token_to_id[token]\n",
        "        for token in prompt_tokens\n",
        "    ]\n",
        "\n",
        "    input_ids = torch.tensor(\n",
        "        [token_ids],\n",
        "        dtype=torch.long,\n",
        "        device=device\n",
        "    )\n",
        "\n",
        "    logits, _ = model(input_ids)\n",
        "\n",
        "    # 마지막 위치에서의 다음 토큰 logits\n",
        "    next_token_logits = logits[\n",
        "        :,\n",
        "        -1,\n",
        "        :\n",
        "    ]\n",
        "\n",
        "    for temperature in temperatures:\n",
        "\n",
        "        scaled_logits = (\n",
        "            next_token_logits / temperature\n",
        "        )\n",
        "\n",
        "        probabilities = F.softmax(\n",
        "            scaled_logits,\n",
        "            dim=-1\n",
        "        )\n",
        "\n",
        "        top_probabilities, top_token_ids = torch.topk(\n",
        "            probabilities,\n",
        "            k=min(top_n, probabilities.size(-1)),\n",
        "            dim=-1\n",
        "        )\n",
        "\n",
        "        print(\"=\" * 60)\n",
        "        print(f\"Temperature = {temperature}\")\n",
        "\n",
        "        for probability, token_id in zip(\n",
        "            top_probabilities[0].tolist(),\n",
        "            top_token_ids[0].tolist(),\n",
        "        ):\n",
        "\n",
        "            token = id_to_token[token_id]\n",
        "\n",
        "            print(\n",
        "                f\"{token:12s}: \"\n",
        "                f\"{probability:.4f}\"\n",
        "            )\n",
        "\n",
        "        print()\n",
        "\n",
        "\n",
        "show_next_token_probabilities(\n",
        "    model=model,\n",
        "    prompt=\"AI helps\",\n",
        "    temperatures=(0.3, 1.0, 1.5),\n",
        ")"
      ],

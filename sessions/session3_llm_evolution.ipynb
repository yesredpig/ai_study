            "Temperature + Top-k + Top-p\n",
            "1: AI helps doctors review records\n",
            "2: AI helps nurses monitor patients\n",
            "3: AI helps doctors review records\n",
            "4: AI helps doctors diagnose disease\n",
            "5: AI helps doctors review records\n",
            "\n"
          ]
        }

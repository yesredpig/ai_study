      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# 12. Temperature, Top-k, Top-p Sampling 비교\n",
        "#\n",
        "# 같은 모델과 같은 prompt를 사용하더라도\n",
        "# 토큰 선택 방법에 따라 서로 다른 문장이 생성될 수 있습니다.\n",
        "#\n",
        "# - Greedy: 항상 가장 확률이 높은 토큰 선택\n",
        "# - Temperature: 확률분포의 날카로움 조절\n",
        "# - Top-k: 확률이 높은 상위 k개 토큰만 후보로 사용\n",
        "# - Top-p: 누적 확률이 p가 될 때까지의 토큰만 후보로 사용\n",
        "# ============================================================\n",
        "\n",
        "import torch\n",
        "import torch.nn.functional as F\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Top-k Filtering\n",
        "#\n",
        "# 확률이 높은 상위 k개의 토큰만 남기고,\n",
        "# 나머지 토큰의 logit은 -inf로 설정합니다.\n",
        "#\n",
        "# softmax(-inf) = 0이므로 선택 후보에서 제외됩니다.\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def apply_top_k(logits, top_k=None):\n",
        "\n",
        "    if top_k is None:\n",
        "        return logits\n",
        "\n",
        "    # vocabulary 크기보다 큰 k가 들어오지 않도록 제한합니다.\n",
        "    top_k = min(top_k, logits.size(-1))\n",
        "\n",
        "    # 상위 k개 중 가장 작은 logit을 기준값으로 사용합니다.\n",
        "    top_k_values, _ = torch.topk(\n",
        "        logits,\n",
        "        k=top_k,\n",
        "        dim=-1\n",
        "    )\n",
        "\n",
        "    threshold = top_k_values[:, -1].unsqueeze(-1)\n",
        "\n",
        "    # 기준값보다 작은 logit은 모두 -inf로 변경합니다.\n",
        "    filtered_logits = torch.where(\n",
        "        logits < threshold,\n",
        "        torch.full_like(logits, float(\"-inf\")),\n",
        "        logits\n",
        "    )\n",
        "\n",
        "    return filtered_logits\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Top-p Filtering\n",
        "#\n",
        "# 확률이 높은 토큰부터 정렬한 뒤,\n",
        "# 누적 확률이 p를 넘을 때까지의 토큰만 후보로 남깁니다.\n",
        "#\n",
        "# 예:\n",
        "# 확률 = [0.50, 0.25, 0.15, 0.10]\n",
        "# top_p = 0.80\n",
        "#\n",
        "# 누적 확률:\n",
        "# 0.50\n",
        "# 0.75\n",
        "# 0.90  ← 0.80을 처음 초과\n",
        "#\n",
        "# 따라서 앞의 3개 토큰을 후보로 사용할 수 있습니다.\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def apply_top_p(logits, top_p=None):\n",
        "\n",
        "    if top_p is None:\n",
        "        return logits\n",
        "\n",
        "    if not 0 < top_p <= 1:\n",
        "        raise ValueError(\n",
        "            \"top_p는 0보다 크고 1 이하이어야 합니다.\"\n",
        "        )\n",
        "\n",
        "    # logit을 높은 순서대로 정렬합니다.\n",
        "    sorted_logits, sorted_indices = torch.sort(\n",
        "        logits,\n",
        "        descending=True,\n",
        "        dim=-1\n",
        "    )\n",
        "\n",
        "    # 정렬된 logit을 확률로 변환합니다.\n",
        "    sorted_probabilities = F.softmax(\n",
        "        sorted_logits,\n",
        "        dim=-1\n",
        "    )\n",
        "\n",
        "    # 높은 확률부터 누적 확률을 계산합니다.\n",
        "    cumulative_probabilities = torch.cumsum(\n",
        "        sorted_probabilities,\n",
        "        dim=-1\n",
        "    )\n",
        "\n",
        "    # 누적 확률이 top_p를 초과하는 토큰을 제거합니다.\n",
        "    sorted_remove_mask = (\n",
        "        cumulative_probabilities > top_p\n",
        "    )\n",
        "\n",
        "    # top_p를 처음 초과하게 만든 토큰까지는 남깁니다.\n",
        "    # 그렇지 않으면 가장 높은 토큰 하나만 남을 수 있습니다.\n",
        "    sorted_remove_mask[:, 1:] = (\n",
        "        sorted_remove_mask[:, :-1].clone()\n",
        "    )\n",
        "\n",
        "    sorted_remove_mask[:, 0] = False\n",
        "\n",
        "    # 정렬된 위치의 mask를 원래 vocabulary 순서로 되돌립니다.\n",
        "    remove_mask = torch.zeros_like(\n",
        "        sorted_remove_mask\n",
        "    )\n",
        "\n",
        "    remove_mask.scatter_(\n",
        "        dim=-1,\n",
        "        index=sorted_indices,\n",
        "        src=sorted_remove_mask\n",
        "    )\n",
        "\n",
        "    filtered_logits = logits.masked_fill(\n",
        "        remove_mask,\n",
        "        float(\"-inf\")\n",
        "    )\n",
        "\n",
        "    return filtered_logits\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Sampling 기반 생성 함수\n",
        "#\n",
        "# do_sample=False:\n",
        "#   Greedy decoding을 사용합니다.\n",
        "#\n",
        "# do_sample=True:\n",
        "#   확률분포에서 torch.multinomial()로 토큰을 표본 추출합니다.\n",
        "#\n",
        "# Temperature, Top-k, Top-p는 함께 사용할 수도 있습니다.\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "@torch.no_grad()\n",
        "def generate_with_sampling(\n",
        "    model,\n",
        "    prompt,\n",
        "    max_new_tokens=10,\n",
        "    temperature=1.0,\n",
        "    top_k=None,\n",
        "    top_p=None,\n",
        "    do_sample=True,\n",
        "):\n",
        "\n",
        "    model.eval()\n",
        "\n",
        "    if temperature <= 0:\n",
        "        raise ValueError(\n",
        "            \"temperature는 0보다 커야 합니다.\"\n",
        "        )\n",
        "\n",
        "    # Prompt 앞에 문장 시작 토큰을 추가합니다.\n",
        "    prompt_tokens = [\n",
        "        \"<BOS>\"\n",
        "    ] + prompt.split()\n",
        "\n",
        "    # 문자열 토큰을 정수 token ID로 변환합니다.\n",
        "    try:\n",
        "        token_ids = [\n",
        "            token_to_id[token]\n",
        "            for token in prompt_tokens\n",
        "        ]\n",
        "    except KeyError as error:\n",
        "        raise ValueError(\n",
        "            f\"Vocabulary에 없는 토큰입니다: {error}\"\n",
        "        ) from error\n",
        "\n",
        "    generated = torch.tensor(\n",
        "        [token_ids],\n",
        "        dtype=torch.long,\n",
        "        device=device\n",
        "    )\n",
        "\n",
        "    for _ in range(max_new_tokens):\n",
        "\n",
        "        # 모델이 처리할 수 있는 최대 길이까지만 사용합니다.\n",
        "        context = generated[\n",
        "            :,\n",
        "            -model.max_sequence_length:\n",
        "        ]\n",
        "\n",
        "        # 각 위치의 vocabulary logits을 계산합니다.\n",
        "        logits, _ = model(context)\n",
        "\n",
        "        # 생성에서는 마지막 위치의 logits만 필요합니다.\n",
        "        next_token_logits = logits[\n",
        "            :,\n",
        "            -1,\n",
        "            :\n",
        "        ]\n",
        "\n",
        "        if not do_sample:\n",
        "\n",
        "            # Greedy decoding:\n",
        "            # 가장 logit이 높은 토큰을 선택합니다.\n",
        "            next_token_id = torch.argmax(\n",
        "                next_token_logits,\n",
        "                dim=-1,\n",
        "                keepdim=True\n",
        "            )\n",
        "\n",
        "        else:\n",
        "\n",
        "            # Temperature 적용:\n",
        "            # T < 1이면 분포가 날카로워지고,\n",
        "            # T > 1이면 분포가 평평해집니다.\n",
        "            next_token_logits = (\n",
        "                next_token_logits / temperature\n",
        "            )\n",
        "\n",
        "            # Top-k filtering 적용\n",
        "            next_token_logits = apply_top_k(\n",
        "                next_token_logits,\n",
        "                top_k=top_k\n",
        "            )\n",
        "\n",
        "            # Top-p filtering 적용\n",
        "            next_token_logits = apply_top_p(\n",
        "                next_token_logits,\n",
        "                top_p=top_p\n",
        "            )\n",
        "\n",
        "            # Filtering 후 logit을 확률로 변환합니다.\n",
        "            probabilities = F.softmax(\n",
        "                next_token_logits,\n",
        "                dim=-1\n",
        "            )\n",
        "\n",
        "            # 확률분포에 따라 다음 토큰을 하나 추출합니다.\n",
        "            next_token_id = torch.multinomial(\n",
        "                probabilities,\n",
        "                num_samples=1\n",
        "            )\n",
        "\n",
        "        # 생성된 토큰을 기존 입력 뒤에 추가합니다.\n",
        "        generated = torch.cat(\n",
        "            [\n",
        "                generated,\n",
        "                next_token_id\n",
        "            ],\n",
        "            dim=1\n",
        "        )\n",
        "\n",
        "        # 문장 종료 토큰이 생성되면 중단합니다.\n",
        "        if (\n",
        "            next_token_id.item()\n",
        "            == token_to_id[\"<EOS>\"]\n",
        "        ):\n",
        "            break\n",
        "\n",
        "    return decode(\n",
        "        generated[0].tolist()\n",
        "    )"
      ],

        "# ------------------------------------------------------------\n",
        "# 11. Autoregressive Generation\n",
        "#\n",
        "# 학습 시:\n",
        "# 모든 위치의 next-token loss를 병렬 계산\n",
        "#\n",
        "# 생성 시:\n",
        "# 마지막 위치의 확률분포에서 토큰 하나를 선택하고\n",
        "# 입력 뒤에 추가하는 과정을 반복\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "@torch.no_grad()\n",
        "def generate(\n",
        "    model,\n",
        "    prompt,\n",
        "    max_new_tokens=10,\n",
        "):\n",
        "\n",
        "    model.eval()\n",
        "\n",
        "    # 문장의 시작을 나타내는 <BOS>를 추가합니다.\n",
        "    prompt_tokens = [\n",
        "        \"<BOS>\"\n",
        "    ] + prompt.split()\n",
        "\n",
        "    token_ids = [\n",
        "        token_to_id[token]\n",
        "        for token in prompt_tokens\n",
        "    ]\n",
        "\n",
        "    generated = torch.tensor(\n",
        "        [token_ids],\n",
        "        dtype=torch.long,\n",
        "        device=device\n",
        "    )\n",
        "\n",
        "    for _ in range(max_new_tokens):\n",
        "\n",
        "        # 모델이 처리할 수 있는 최대 길이만 사용합니다.\n",
        "        context = generated[\n",
        "            :,\n",
        "            -model.max_sequence_length:\n",
        "        ]\n",
        "\n",
        "        logits, _ = model(context)\n",
        "\n",
        "        # 생성에서는 마지막 위치의 logits만 필요합니다.\n",
        "        next_token_logits = logits[\n",
        "            :,\n",
        "            -1,\n",
        "            :\n",
        "        ]\n",
        "\n",
        "        probabilities = torch.softmax(\n",
        "            next_token_logits,\n",
        "            dim=-1\n",
        "        )\n",
        "\n",
        "        # 가장 확률이 높은 토큰 선택\n",
        "        next_token_id = torch.argmax(\n",
        "            probabilities,\n",
        "            dim=-1,\n",
        "            keepdim=True\n",
        "        )\n",
        "\n",
        "        generated = torch.cat(\n",
        "            [\n",
        "                generated,\n",
        "                next_token_id\n",
        "            ],\n",
        "            dim=1\n",
        "        )\n",
        "\n",
        "        # <EOS>가 생성되면 문장 생성을 종료합니다.\n",
        "        if next_token_id.item() == token_to_id[\"<EOS>\"]:\n",
        "            break\n",
        "\n",
        "    return decode(\n",
        "        generated[0].tolist()\n",
        "    )\n",
        "\n",
        "\n",
        "generated_text = generate(\n",
        "    model,\n",
        "    prompt=\"AI helps doctors\",\n",
        "    max_new_tokens=5\n",
        ")\n",
        "\n",
